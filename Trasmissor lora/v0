// === HELTEC ESP32 LoRa - TRANSMISSOR LoRa + RECEPTOR ESP-NOW ===
// Lê DHT11 (temperatura/umidade) + MQ9 (analógico) localmente,
// recebe via ESP-NOW (tempoLigado, solo) e envia TUDO via LoRa.
// Contadores de teste (100/200) foram removidos.

#include <WiFi.h>
#include <esp_now.h>
extern "C" {
  #include "esp_wifi.h"
}
#include "LoRaWan_APP.h"
#include "Arduino.h"

// ---- DHT11 (Adafruit Unified) ----
#include <Adafruit_Sensor.h>
#include <DHT.h>
#include <DHT_U.h>
#define DHTTYPE DHT11
#define DHTPIN  33         // <-- MUDANÇA: Pino 2 pode conflitar (LED). Use um pino livre como o 33.
DHT_Unified dht(DHTPIN, DHTTYPE);
uint32_t dhtDelayMS = 2000; // default; será atualizado pelo sensor

// ---- MQ-9 ----
#define MQ9_PIN 7          // pino analógico (ADC) - ajuste conforme seu hardware

// ---- LoRa ----
#define RF_FREQUENCY      915000000
#define TX_OUTPUT_POWER   5
#define LORA_BANDWIDTH    0
#define LORA_SPREADING_FACTOR 7
#define LORA_CODINGRATE   1
#define LORA_PREAMBLE_LENGTH 8
#define LORA_SYMBOL_TIMEOUT 0
#define LORA_FIX_LENGTH_PAYLOAD_ON false
#define LORA_IQ_INVERSION_ON false
#define BUFFER_SIZE       180

char txpacket[BUFFER_SIZE];
bool lora_idle = true;
static RadioEvents_t RadioEvents;

// ---- Estrutura recebida via ESP-NOW (sem alterações no TX ESP-NOW) ----
typedef struct struct_dados {
  uint32_t tempoLigado;
  uint16_t solo;
} struct_dados;

struct_dados dadosRecebidos;
uint32_t tempoLigadoNow = 0;
uint16_t soloNow = 0;

// ---- Callback ESP-NOW ----
void OnEspNowReceive(const esp_now_recv_info_t *info, const uint8_t *data, int len) {
  if (len >= (int)sizeof(dadosRecebidos)) {
    memcpy(&dadosRecebidos, data, sizeof(dadosRecebidos));
    tempoLigadoNow = dadosRecebidos.tempoLigado;
    soloNow = dadosRecebidos.solo;
    Serial.printf("[ESP-NOW] tempo=%lu, solo=%u\n", tempoLigadoNow, soloNow);
  } else {
    Serial.printf("[ESP-NOW] Pacote menor que esperado (%d bytes)\n", len);
  }
}

// ---- Callbacks LoRa ----
void OnTxDone(void) {
  Serial.println("[LoRa] TX concluído.");
  lora_idle = true;
}

void OnTxTimeout(void) {
  Radio.Sleep();
  Serial.println("[LoRa] TX Timeout");
  lora_idle = true;
}

void setup() {
  Serial.begin(115200);
  delay(500);

  // ESP-NOW (somente recepção)
  WiFi.mode(WIFI_STA);
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
  esp_wifi_start();
  if (esp_now_init() != ESP_OK) {
    Serial.println("Erro ao iniciar ESP-NOW");
    return;
  }
  esp_now_register_recv_cb(OnEspNowReceive);

  // Sensores locais
  dht.begin();
  // Captura min_delay do DHT (vem em microssegundos); converte para ms
  sensor_t sensor;
  dht.temperature().getSensor(&sensor);
  if (sensor.min_delay > 0) dhtDelayMS = sensor.min_delay / 1000;
  pinMode(MQ9_PIN, INPUT);

  // LoRa
  Mcu.begin(HELTEC_BOARD, SLOW_CLK_TPYE);
  RadioEvents.TxDone = OnTxDone;
  RadioEvents.TxTimeout = OnTxTimeout;
  Radio.Init(&RadioEvents);
  Radio.SetChannel(RF_FREQUENCY);
  Radio.SetTxConfig(MODEM_LORA, TX_OUTPUT_POWER, 0, LORA_BANDWIDTH,
                    LORA_SPREADING_FACTOR, LORA_CODINGRATE, LORA_PREAMBLE_LENGTH,
                    LORA_FIX_LENGTH_PAYLOAD_ON, true, 0, 0, LORA_IQ_INVERSION_ON, 3000);

  Serial.println("LoRa + ESP-NOW transmissor pronto!");
}

unsigned long lastSend = 0;

void loop() {
  // Respeita o tempo mínimo do DHT
  if (millis() - lastSend >= dhtDelayMS && lora_idle) {
    // Leituras do DHT11
    sensors_event_t evt;
    float temperatura = NAN, umidade = NAN;

    dht.temperature().getEvent(&evt);
    if (!isnan(evt.temperature)) temperatura = evt.temperature;

    dht.humidity().getEvent(&evt);
    if (!isnan(evt.relative_humidity)) umidade = evt.relative_humidity;

    // MQ-9 (ADC)
    int mq9Value = analogRead(MQ9_PIN);

    // Tratamento de falhas DHT
    if (isnan(temperatura) || isnan(umidade)) {
      Serial.println("[DHT] Falha na leitura (usando 0)");
      if (isnan(temperatura)) temperatura = 0.0f;
      if (isnan(umidade))     umidade = 0.0f;
    }

    // Monta payload textual (simples e legível)
    snprintf(txpacket, BUFFER_SIZE,
             "tempo=%lu,solo=%u,temp=%.1fC,umid=%.1f%%,mq9=%d",
             tempoLigadoNow, soloNow, temperatura, umidade, mq9Value);

    Serial.printf("[LoRa->] %s\n", txpacket);

    Radio.Send((uint8_t*)txpacket, strlen(txpacket));
    lora_idle = false;
    lastSend = millis();
  }

  Radio.IrqProcess();
}
