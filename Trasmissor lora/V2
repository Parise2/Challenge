// === HELTEC ESP32 LoRa - TRANSMISSOR LoRa + RECEPTOR ESP-NOW ===
// Lê DHT11 (temperatura/umidade) + MQ9 (analógico) + HX711 (dendrômetro) + BATERIA (local)
// recebe via ESP-NOW (tempoLigado, solo) e envia TUDO via LoRa.

#include <WiFi.h>
#include <esp_now.h>
extern "C" {
  #include "esp_wifi.h"
}
#include "LoRaWan_APP.h"
#include "Arduino.h"

// ---- DHT11 (Adafruit Unified) ----
#include <Adafruit_Sensor.h>
#include <DHT.h>
#include <DHT_U.h>
#define DHTTYPE DHT22
#define DHTPIN  33
DHT_Unified dht(DHTPIN, DHTTYPE);
uint32_t dhtDelayMS = 2000;

// ---- MQ-9 ----
#define MQ9_PIN 7

// ---- HX711 (Dendrômetro) ----
#include "HX711.h"
#define HX711_DOUT 19
#define HX711_CLK  20

HX711 balanca;

// ---- BATERIA (ADC) - NOVO ----
#define BATT_ADC_PIN 5       // ALTERADO: Pino 5 (GPIO5 / ADC1_CH4)
const float R1 = 10000.0;         // Resistor R1 do divisor de tensão
const float R2 = 5600.0;          // Resistor R2 do divisor de tensão
const float VREF = 3.3;           // Tensão de referência do ESP32
const float ADC_MAX = 4095.0;     // Resolução 12-bit
const float VOLT_MAX = 7.4;       // 7.4V = 100%
const float VOLT_MIN = 6.0;       // 6.0V = 0% 
const int NUM_SAMPLES = 64;       // Número de amostras para média
const float ADC_STABILITY_MARGIN = 20.0; // Margem de ruído
float lastStablePercentage = 0.0;        // Última % estável
float lastStableRawValue = -100.0;       // Último valor bruto estável
float g_lastVoltageAtPin = 0.0;          // NOVO: Armazena a última tensão estável do pino

// ---- Variáveis para Tratamento de Erros e Leitura do HX711 ----
float calibration_factor = 29000;
float last_weight = 0.0;
float current_weight = 0.0;
float weight_threshold = 0.02;
float drop_reset_threshold = 0.2; // Esta variável agora não é usada na lógica ativa

// ---- LoRa ----
#define RF_FREQUENCY          915000000
#define TX_OUTPUT_POWER       5
#define LORA_BANDWIDTH        0
#define LORA_SPREADING_FACTOR 7
#define LORA_CODINGRATE       1
#define LORA_PREAMBLE_LENGTH  8
#define LORA_SYMBOL_TIMEOUT   0
#define LORA_FIX_LENGTH_PAYLOAD_ON false
#define LORA_IQ_INVERSION_ON false
#define BUFFER_SIZE           180 // Aumentado para comportar a bateria

char txpacket[BUFFER_SIZE];
bool lora_idle = true;
static RadioEvents_t RadioEvents;

// ---- Estrutura recebida via ESP-NOW ----
typedef struct struct_dados {
  uint32_t tempoLigado;
  uint16_t solo;
} struct_dados;

struct_dados dadosRecebidos;
uint32_t tempoLigadoNow = 0; 
uint16_t soloNow = 0;

// ---- Callback ESP-NOW ----
void OnEspNowReceive(const esp_now_recv_info_t *info, const uint8_t *data, int len) {
  if (len >= (int)sizeof(dadosRecebidos)) {
    memcpy(&dadosRecebidos, data, sizeof(dadosRecebidos));
    tempoLigadoNow = dadosRecebidos.tempoLigado;
    soloNow = dadosRecebidos.solo;
    Serial.printf("[ESP-NOW] tempo=%lu, solo=%u\n", tempoLigadoNow, soloNow);
  } else {
    Serial.printf("[ESP-NOW] Pacote menor que esperado (%d bytes)\n", len);
  }
}

// ---- Callbacks LoRa ----
void OnTxDone(void) {
  Serial.println("[LoRa] TX concluído.");
  lora_idle = true;
}

void OnTxTimeout(void) {
  Radio.Sleep();
  Serial.println("[LoRa] TX Timeout");
  lora_idle = true;
}

// ---- FUNÇÃO DE LEITURA DA BATERIA (VERSÃO FINAL) ----
float getBatteryPercentage() {
  // 1. Ler o valor bruto do ADC (com média)
  long rawValueSum = 0;
  for (int i = 0; i < NUM_SAMPLES; i++) {
    rawValueSum += analogRead(BATT_ADC_PIN);
    delay(1); 
  }
  float avgRawValue = (float)rawValueSum / NUM_SAMPLES;

  // 2. LÓGICA DE ESTABILIZAÇÃO
  if (abs(avgRawValue - lastStableRawValue) > ADC_STABILITY_MARGIN) {
    // MUDANÇA REAL DETECTADA!
    
    // 2a. Converter valor bruto para tensão no pino do ADC
    float voltageAtPin = (avgRawValue / ADC_MAX) * VREF; 

    // 2b. Converter tensão no pino para tensão real da bateria
    float batteryVoltage = voltageAtPin * ( (R1 + R2) / R2 );

    // 2c. Calcular a porcentagem
    float currentPercentage = ((batteryVoltage - VOLT_MIN) / (VOLT_MAX - VOLT_MIN)) * 100.0;

    // 2d. Limitar (clampar) a porcentagem entre 0% e 100%
    if (currentPercentage > 100.0) {
      currentPercentage = 100.0;
    }
    if (currentPercentage < 0.0) {
      currentPercentage = 0.0;
    }
    
    // 2e. Atualizar nossas variáveis de controle
    lastStablePercentage = currentPercentage;
    lastStableRawValue = avgRawValue;
    g_lastVoltageAtPin = voltageAtPin; // <-- NOVO: Salva a tensão do pino
  }
  
  // 3. Retornar o resultado
  return lastStablePercentage;
}


void setup() {
  Serial.begin(115200);
  delay(500);

  // ESP-NOW (somente recepção)
  WiFi.mode(WIFI_STA);
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
  esp_wifi_start();
  if (esp_now_init() != ESP_OK) {
    Serial.println("Erro ao iniciar ESP-NOW");
    return;
  }
  esp_now_register_recv_cb(OnEspNowReceive);

  // Sensores locais
  dht.begin();
  sensor_t sensor;
  dht.temperature().getSensor(&sensor);
  if (sensor.min_delay > 0) dhtDelayMS = sensor.min_delay / 1000;
  pinMode(MQ9_PIN, INPUT);

  // ---- ADICIONADO: Configuração do ADC da Bateria ----
  analogSetPinAttenuation(BATT_ADC_PIN, ADC_11db);

  // ---- Inicialização do Dendrômetro (HX711) ----
  balanca.begin(HX711_DOUT, HX711_CLK);
  balanca.set_scale(calibration_factor);
  balanca.tare();
  Serial.println("Dendrômetro (HX711) inicializado e tarado.");

  // LoRa
  Mcu.begin(HELTEC_BOARD, SLOW_CLK_TPYE);
  RadioEvents.TxDone = OnTxDone;
  RadioEvents.TxTimeout = OnTxTimeout;
  Radio.Init(&RadioEvents);
  Radio.SetChannel(RF_FREQUENCY);
  Radio.SetTxConfig(MODEM_LORA, TX_OUTPUT_POWER, 0, LORA_BANDWIDTH,
                    LORA_SPREADING_FACTOR, LORA_CODINGRATE, LORA_PREAMBLE_LENGTH,
                    LORA_FIX_LENGTH_PAYLOAD_ON, true, 0, 0, LORA_IQ_INVERSION_ON, 3000);

  Serial.println("LoRa + ESP-NOW + Sensores Locais pronto!");
}

unsigned long lastSend = 0;

void loop() {
  if (millis() - lastSend >= dhtDelayMS && lora_idle) {
    // --- Leituras dos Sensores ---
    
    // 1. DHT11
    sensors_event_t evt;
    float temperatura = NAN, umidade = NAN;
    dht.temperature().getEvent(&evt);
    if (!isnan(evt.temperature)) temperatura = evt.temperature;
    dht.humidity().getEvent(&evt);
    if (!isnan(evt.relative_humidity)) umidade = evt.relative_humidity;

    // 2. MQ-9 (ADC)
    int mq9Value = analogRead(MQ9_PIN);

    // 3. Leitura do Dendrômetro (HX711)
    current_weight = balanca.get_units(5);
    if (current_weight < 0) {
      current_weight = 0;
    }

    // === INÍCIO DA ALTERAÇÃO ===
    if (abs(current_weight - last_weight) >= weight_threshold) {
      // (lógica do dendrômetro omitida para brevidade)
      last_weight = current_weight;
    }
    // === FIM DA ALTERAÇÃO ===
    
    // 4. Leitura da Bateria (NOVO)
    // A função é chamada e atualiza 'g_lastVoltageAtPin' internamente
    float bateriaPct = getBatteryPercentage(); 

    // Tratamento de falhas DHT
    if (isnan(temperatura) || isnan(umidade)) {
      Serial.println("[DHT] Falha na leitura (usando 0)");
      if (isnan(temperatura)) temperatura = 0.0f;
      if (isnan(umidade))     umidade = 0.0f;
    }

    // --- Montagem do Pacote LoRa ---

    // [ALTERAÇÃO SOLICITADA] Adicionado "vpin=%.3fV" ao final da string
    snprintf(txpacket, BUFFER_SIZE,
             "tempo=%.3fkg,solo=%u,temp=%.1fC,umid=%.1f%%,mq9=%d,bateria=%.1f%%,vpin=%.3fV",
             last_weight, soloNow, temperatura, umidade, mq9Value, bateriaPct, g_lastVoltageAtPin);

    Serial.printf("[LoRa->] %s\n", txpacket);

    Radio.Send((uint8_t*)txpacket, strlen(txpacket));
    lora_idle = false;
    lastSend = millis();
  }

  Radio.IrqProcess();
}
