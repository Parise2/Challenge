#include "LoRaWan_APP.h"
#include "Arduino.h"
#include <WiFi.h>
#include <PubSubClient.h>

// --- Configurações LoRa ---
#define RF_FREQUENCY          915000000
#define LORA_BANDWIDTH        0
#define LORA_SPREADING_FACTOR 7
#define LORA_CODINGRATE       1
#define LORA_PREAMBLE_LENGTH  8
#define LORA_SYMBOL_TIMEOUT   0
#define LORA_FIX_LENGTH_PAYLOAD_ON false
#define LORA_IQ_INVERSION_ON false
#define BUFFER_SIZE           200

char rxpacket[BUFFER_SIZE];
static RadioEvents_t RadioEvents;
bool lora_idle = true;

// --- Configurações WiFi e MQTT ---
const char* ssid = "proibidocelular";
const char* password = "parise123";
const char* mqtt_server = "test.mosquitto.org"; // Ex: "192.168.1.100"
const int mqtt_port = 1883;
const char* mqtt_topic_base = "sensores/loraALGUMACOISADAMINHACABEÇA3005"; // Tópico base para publicação

WiFiClient espClient;
PubSubClient client(espClient);

// --- Declaração de Funções ---
void setup_wifi();
void reconnect_mqtt();
void OnRxDone(uint8_t *payload, uint16_t size, int16_t rssi, int8_t snr);

void setup() {
  Serial.begin(115200);
  Mcu.begin(HELTEC_BOARD, SLOW_CLK_TPYE);

  // Inicia o WiFi e se conecta
  setup_wifi();

  // Configura o cliente MQTT
  client.setServer(mqtt_server, mqtt_port);

  // Configura as funções do rádio LoRa
  RadioEvents.RxDone = OnRxDone;
  Radio.Init(&RadioEvents);
  Radio.SetChannel(RF_FREQUENCY);
  Radio.SetRxConfig(MODEM_LORA, LORA_BANDWIDTH, LORA_SPREADING_FACTOR,
                    LORA_CODINGRATE, 0, LORA_PREAMBLE_LENGTH, LORA_SYMBOL_TIMEOUT,
                    LORA_FIX_LENGTH_PAYLOAD_ON, 0, true, 0, 0,
                    LORA_IQ_INVERSION_ON, true);

  Serial.println("LoRa receptor pronto. Aguardando pacotes...");
}

void loop() {
  // Mantém a conexão MQTT
  if (!client.connected()) {
    reconnect_mqtt();
  }
  client.loop();

  // Mantém o receptor LoRa em modo de escuta
  if (lora_idle) {
    lora_idle = false;
    Radio.Rx(0);
  }
  Radio.IrqProcess();
}

void setup_wifi() {
  delay(10);
  Serial.print("Conectando a ");
  Serial.println(ssid);

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi conectado!");
  Serial.print("Endereço IP: ");
  Serial.println(WiFi.localIP());
}

void reconnect_mqtt() {
  while (!client.connected()) {
    Serial.print("Tentando conectar ao broker MQTT...");
    if (client.connect("LoRaGatewayClient")) {
      Serial.println(" conectado!");
    } else {
      Serial.print(" falhou, rc=");
      Serial.print(client.state());
      Serial.println(" tentando novamente em 5 segundos");
      delay(5000);
    }
  }
}

/**
 * @brief Função chamada quando um pacote LoRa é recebido.
 * Esta é a versão ATUALIZADA que interpreta o formato "chave=valor".
 */
void OnRxDone(uint8_t *payload, uint16_t size, int16_t rssi, int8_t snr) {
  size = min<size_t>(size, BUFFER_SIZE - 1);
  memcpy(rxpacket, payload, size);
  rxpacket[size] = '\0';
  Radio.Sleep();

  Serial.printf("[LoRa<-] \"%s\" | RSSI %d | SNR %d | %u bytes\n", rxpacket, rssi, snr, size);

  // --- LÓGICA DE PARSING PARA O FORMATO "chave=valor" ---

  // Faz uma cópia da mensagem para podermos modificá-la
  char data_to_parse[BUFFER_SIZE];
  strncpy(data_to_parse, rxpacket, BUFFER_SIZE);

  // Primeiro, separamos a string pelos delimitadores ","
  char* pair = strtok(data_to_parse, ",");

  while (pair != NULL) {
    // Agora 'pair' contém algo como "temp=25.1C"
    // Vamos separar a chave do valor usando o delimitador "="
    char* value = strchr(pair, '=');

    if (value != NULL) {
      *value = '\0';  // Transforma o '=' em um final de string para isolar a chave (ex: "temp")
      value++;        // Avança o ponteiro para o início do valor (ex: "25.1C")

      char full_topic[100];
      const char* topic_suffix = NULL;

      // Compara a CHAVE ('pair') para decidir o SUFIXO do tópico
      if (strcmp(pair, "temp") == 0) {
        topic_suffix = "temperatura";
      } else if (strcmp(pair, "umid") == 0) {
        topic_suffix = "umidade";
      } else if (strcmp(pair, "solo") == 0) {
        // ATENÇÃO: O transmissor envia "solo". Mapeando para "forca" como pedido.
        // O ideal seria usar o tópico "solo" para maior clareza.
        topic_suffix = "forca"; 
      } else if (strcmp(pair, "mq9") == 0) {
        topic_suffix = "gas";
      } else if (strcmp(pair, "tempo") == 0) {
        // Adicionando o valor 'tempo' que também é enviado
        topic_suffix = "tempoLigado";
      }

      // Se a chave foi reconhecida, publica no tópico correspondente
      if (topic_suffix != NULL) {
        snprintf(full_topic, sizeof(full_topic), "%s%s", mqtt_topic_base, topic_suffix);
        
        // Publica o valor no tópico MQTT
        client.publish(full_topic, value);
        Serial.printf("[MQTT->] Publicado no tópico '%s': \"%s\"\n", full_topic, value);
      }
    }

    // Pega o próximo par "chave=valor"
    pair = strtok(NULL, ",");
  }

  lora_idle = true;
}
