#include <WiFi.h>
#include <esp_now.h>
#include "esp_wifi.h"

// MAC do receptor fornecido
uint8_t enderecoMACReceptor[] = {0x48, 0xCA, 0x43, 0x3D, 0xBB, 0x40};
// Estrutura de dados
typedef struct struct_dados {
  uint32_t tempoLigado;
} struct_dados;

struct_dados dadosEnviar;
uint32_t tempoLigado = 0;

void OnDataSent(const uint8_t *mac_addr, esp_now_send_status_t status) {
  Serial.print("Status de envio: ");
  Serial.println(status == ESP_NOW_SEND_SUCCESS ? "Sucesso" : "Falha");
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  // Modo WiFi STA + canal fixo
  WiFi.mode(WIFI_STA);
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
  WiFi.disconnect(); // Garante que não conecta a nenhuma rede

  // Inicia ESP-NOW
  if (esp_now_init() != ESP_OK) {
    Serial.println("Erro ao iniciar ESP-NOW");
    return;
  }

  // Registra callback de envio
  esp_now_register_send_cb(OnDataSent);

  // Adiciona o peer (receptor)
  esp_now_peer_info_t peerInfo = {};
  memcpy(peerInfo.peer_addr, enderecoMACReceptor, 6);
  peerInfo.channel = 1; // Canal fixo
  peerInfo.encrypt = false;

  if (esp_now_add_peer(&peerInfo) != ESP_OK) {
    Serial.println("Erro ao adicionar peer");
    return;
  }

  Serial.println("Mestre pronto para enviar!");
}

void loop() {
  tempoLigado++;
  dadosEnviar.tempoLigado = tempoLigado;

  // Envia a struct
  esp_err_t resultado = esp_now_send(enderecoMACReceptor, (uint8_t *)&dadosEnviar, sizeof(dadosEnviar));
  
  if (resultado == ESP_OK) {
    Serial.print("Enviado tempoLigado: ");
    Serial.println(tempoLigado);
  } else {
    Serial.println("Erro ao enviar os dados");
  }

  delay(1000); // A cada segundo
}
